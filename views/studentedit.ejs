<%- include("./base/header.ejs") %>
<div class="contaier">
    <div class="alert bg-success my-3">
        <h4 class="text-center text-white">Edit student</h4>

    </div>
    <div class="row">
        <div class="col"></div>
        <div class="col">
        <form action="/edit/student/<%= student._id%>" method="post">
            <div class="mt-5">
                <label for="form-label">Roll No: </label>
                <br>
                <input type="text" placeholder="Enter your Rollno" class="form-control" name="rollNo" value="<%= student.rollNo %>">
                <label for="form-label">Name: </label>
                <br>
                <input type="text" placeholder="Enter your name" class="form-control" name="studentName" value="<%= student.studentName %>">
                <label for="form-label">Father name: </label>
                <br>
                <input type="text" placeholder="Enter your Father name" class="form-control" name="fatherName"value="<%= student.fatherName %>">
                <label for="form-label">Aadhaar Card No: </label>
                <br>
                <input type="text" placeholder="Enter your Aadhaar no." class="form-control" name="aadharCardNo" value="<%= student.aadharCardNo %>">
                <label for="form-label">Mobile No: </label>
                <br>
                <input type="text" placeholder="Enter your Mobile no." class="form-control" name="mobileNo" value="<%= student.mobileNo %>">
                <input type="submit" class=" btn btn-outline-success mt-3 " value="Edit Student">
                </form>
            </div>

        </div>
        <div class="col"></div>
    </div>
</div>

<%- include("./base/footer.ejs") %>